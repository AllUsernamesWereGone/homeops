# ============================================================
# OS files
# ============================================================
.DS_Store
Thumbs.db
Desktop.ini

# ============================================================
# Editor / IDE files
# ============================================================

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Vim
*.swp
*.swo
*~

# ============================================================
# Environment / secrets
# ============================================================

.env
.env.*
!.env.example

infra/.env
infra/.env.*
!infra/.env.example

infra/compose/.env
infra/compose/.env.*
!infra/compose/.env.example

apps/backend/.env
apps/backend/.env.*
!apps/backend/.env.example

apps/frontend/.env
apps/frontend/.env.*
!apps/frontend/.env.example

# ============================================================
# Logs
# ============================================================

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# Java / Maven / Spring Boot backend
# ============================================================

apps/backend/target/
apps/backend/.mvn/timing.properties
apps/backend/application.pid

# Maven wrapper should stay committed
!apps/backend/mvnw
!apps/backend/mvnw.cmd
!apps/backend/.mvn/wrapper/maven-wrapper.properties
!apps/backend/.mvn/wrapper/maven-wrapper.jar

# H2 database files
*.mv.db
*.trace.db
*.lock.db
apps/backend/*.mv.db
apps/backend/*.trace.db
apps/backend/*.lock.db

# ============================================================
# Angular / Node frontend
# ============================================================

apps/frontend/node_modules/
apps/frontend/dist/
apps/frontend/.angular/
apps/frontend/.cache/
apps/frontend/coverage/

# ============================================================
# Docker / local runtime data
# ============================================================

docker-data/
data/
volumes/
tmp/

# Dockerfiles and Compose files should be committed.
# Do not ignore:
# Dockerfile
# docker-compose.yml
# compose.yml

# ============================================================
# Test / coverage output
# ============================================================

coverage/
test-results/
playwright-report/

# ============================================================
# Build artifacts
# ============================================================

*.jar
*.war
*.ear

# Keep Maven wrapper JAR if present
!apps/backend/.mvn/wrapper/maven-wrapper.jar
